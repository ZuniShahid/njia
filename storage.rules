rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // user documents: /users/{uid}/documents/{file}
    match /users/{uid}/documents/{file} {
      allow read, write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/.*');
    }
    // snapshots of fetched source pages, written by the service account only
    match /sources/{sourceId}/{file} {
      allow read: if request.auth != null && (request.auth.token.role == 'editor' || request.auth.token.role == 'admin');
      allow write: if false;
    }
  }
}
